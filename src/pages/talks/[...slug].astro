---
import { getCollection } from 'astro:content';
import { shouldShowContent } from '@/utils/markdown';
import { siteConfig } from '@/config';
import TalkLayout from '@/layouts/TalkLayout.astro';

export async function getStaticPaths() {
  // If talks are disabled, don't generate any paths
  if (!siteConfig.optionalContentTypes.talks) {
    return [];
  }

  const talks = await getCollection('talks');
  const isDev = import.meta.env.DEV;

  const paths = [];

  // Generate paths for all talks - each .md file is a separate talk
  for (const talk of talks) {
    if (!shouldShowContent(talk, isDev)) continue;

    // Use the full talk ID as the slug
    const slug = talk.id;

    paths.push({
      params: { slug: slug },
      props: {
        talk: talk
      }
    });
  }

  return paths;
}

const { talk } = Astro.props;

if (!talk) {
  return Astro.redirect('/talks/', 404);
}
---

<TalkLayout talk={talk} />
